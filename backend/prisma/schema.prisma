generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  clerkId           String             @unique
  goal              String?
  answer1           String?
  answer2           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  routines          Routine[]
  reminders         Reminder[]
  pushSubscriptions PushSubscription[]
}

model Routine {
  id         String   @id @default(cuid())
  clerkId    String
  goal       String
  diet       String?
  experience String?
  routine    String
  createdAt  DateTime @default(now())
  isFavorite Boolean  @default(false)
  isCurrent  Boolean  @default(false)

  user User @relation(fields: [clerkId], references: [clerkId])
}

model RoutineCompletion {
  id        String   @id @default(cuid())
  clerkId   String
  goal      String
  date      String
  taskIndex Int
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clerkId, goal, date, taskIndex])
  @@index([clerkId, date])
}

model Conversation {
  id        String        @id @default(cuid())
  clerkId   String
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([clerkId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ========================================
// AYURAI SMART REMINDERS
// ========================================

model Reminder {
  id              String   @id @default(cuid())
  clerkId         String
  title           String
  type            String   @default("custom")
  time            String
  endTime         String?
  intervalMinutes Int?
  days            String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])
  timezone        String   @default("Asia/Kolkata")
  enabled         Boolean  @default(true)
  snoozeMinutes   Int      @default(10)
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User               @relation(fields: [clerkId], references: [clerkId], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([clerkId, enabled])
}

model PushSubscription {
  id             String   @id @default(cuid())
  clerkId        String
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime Float?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [clerkId], references: [clerkId], onDelete: Cascade)

  @@index([clerkId])
}

model ReminderDelivery {
  id           String    @id @default(cuid())
  reminderId   String
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([status, scheduledFor])
}
